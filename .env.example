# ─────────────────────────────────────────────────────────────────────────────
# FinResearch AI — environment configuration
# Copy to `.env` (repo root) and fill in. Every value has a safe local default,
# so an empty file still boots the app in offline/extractive mode.
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Regex for origins that change per deployment (Vercel preview URLs), e.g.
# CORS_ORIGIN_REGEX=https://finresearch-ai(-[a-z0-9-]+)?\.vercel\.app
CORS_ORIGIN_REGEX=

# ── LLM (provider-agnostic, OpenAI-compatible) ──────────────────────────────
# LLM_PROVIDER: auto | groq | openai | local | none
#   auto  → groq if the key starts with "gsk_", openai for any other key, else none
#   local → any OpenAI-compatible server (Ollama, vLLM, LM Studio); set LLM_BASE_URL
#   none  → extractive mode: computed metrics + quoted evidence, no generation
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SECONDS=60

# ── Embeddings ──────────────────────────────────────────────────────────────
# EMBEDDING_PROVIDER: fastembed | sentence_transformers | openai | hash
#   fastembed             → BGE via ONNX runtime (default, no PyTorch needed)
#   sentence_transformers → requires `pip install -r requirements-optional.txt`
#   openai                → any OpenAI-compatible /embeddings endpoint
#   hash                  → deterministic offline embedder (tests / air-gapped demos)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ── Reranker ────────────────────────────────────────────────────────────────
# RERANKER_PROVIDER: fastembed | sentence_transformers | lexical | none
RERANKER_PROVIDER=fastembed
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ── Retrieval tuning ────────────────────────────────────────────────────────
SEMANTIC_TOP_K=20
BM25_TOP_K=20
SEMANTIC_WEIGHT=0.7
KEYWORD_WEIGHT=0.3
FUSION_METHOD=weighted             # weighted | rrf
RERANK_TOP_N=6

# ── Vector database ─────────────────────────────────────────────────────────
# VECTOR_STORE: auto | qdrant | local | memory
#   auto   → qdrant when QDRANT_URL is set, otherwise local
#   qdrant → Qdrant server or Qdrant Cloud over REST (set QDRANT_URL, and QDRANT_API_KEY for Cloud)
#   local  → exact cosine search persisted under DATA_DIR/vectors (no server needed)
#   memory → ephemeral, for tests
VECTOR_STORE=auto
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=finresearch_chunks

# ── Relational database ─────────────────────────────────────────────────────
# Empty → SQLite at DATA_DIR/finresearch.db.
# Postgres: postgresql+psycopg://user:password@host:5432/finresearch
DATABASE_URL=

# ── Cache / rate limiting (optional; falls back to in-process) ──────────────
REDIS_URL=

# ── Storage & upload limits ─────────────────────────────────────────────────
DATA_DIR=
# Where embedding/reranker models are downloaded (default: DATA_DIR/models, ~200 MB).
MODEL_CACHE=
MAX_UPLOAD_MB=50

# ── Security ────────────────────────────────────────────────────────────────
# AUTH_ENABLED=true requires an `X-API-Key` (or Bearer) header on every request.
# API_KEYS is a comma-separated list of key:role (role = viewer | analyst | admin).
AUTH_ENABLED=false
API_KEYS=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# ── Observability ───────────────────────────────────────────────────────────
# Query text is hashed in traces unless TRACE_QUERY_TEXT=true.
TRACE_QUERY_TEXT=false
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=finresearch-ai
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Docker Compose only ─────────────────────────────────────────────────────
POSTGRES_USER=finresearch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finresearch

# ── Frontend (set in frontend/.env.local or the Vercel dashboard) ───────────
# NEXT_PUBLIC_API_URL=http://localhost:8000
